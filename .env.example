VITE_API_BASE_URL=
VITE_API_ROOT_URL=
PORT=
# Base URL of the "Powered by AI" search service (API Gateway stage).
# Required for the search overlay; without it the client falls back to /prod
# and every search fails. Vite bakes this in at build time, so set it before
# building and redeploy after changing it.
VITE_AI_SEARCH_BASE_URL=https://1f56j28jcc.execute-api.eu-west-1.amazonaws.com/prod
# Image/media uploads now go through the backend's S3 presigned-URL endpoint
# (POST /upload/presign), so no upload credentials are needed in the frontend.